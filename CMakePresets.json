{
  "version" : 6,
  "cmakeMinimumRequired" : {
    "major" : 3,
    "minor" : 21,
    "patch" : 0
  },
 "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "base-debug",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern"
      }
    },
    {
      "name": "base-release",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -ftrivial-auto-var-init=uninitialized"
      }
    },
    {
      "name": "base-benchmarks",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -ftrivial-auto-var-init=uninitialized"
      }
    },

    {
      "name": "base-clang",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "$env{SOLUX_ENABLE_CLANG}",
        "rhs": "1"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "base-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },

    {
      "name": "features-asan",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-g -fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address"
      }
    },

    {
      "name": "gcc-debug",
      "inherits": ["base", "base-gcc", "base-debug"],
      "displayName": "GCC Debug (recommended for iteration)",
      "description": "Default for the edit-build-test loop. Non-ASan: ~31% faster per cycle than gcc-debug-asan (no ASan compile/link tax, tests run ~2.5x faster). PCH + ccache + mold auto-enabled.",
      "toolchainFile": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "gcc-release",
      "inherits": ["base", "base-gcc", "base-release"],
      "displayName": "GCC Release",
      "description": "Optimized build for benchmarking and release-perf checks (non-ASan).",
      "toolchainFile": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "gcc-debug-asan",
      "inherits": ["base", "base-gcc", "base-debug", "features-asan"],
      "displayName": "GCC Debug ASAN (memory checks only)",
      "description": "Use before committing or when chasing a crash/UB (use-after-free, leaks, OOB). NOT the default iteration build: ASan adds ~3.7s/build and makes tests ~2.5x slower.",
      "toolchainFile": "/opt/vcpkg_asan/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "gcc-release-asan",
      "inherits": ["base", "base-gcc", "base-release", "features-asan"],
      "displayName": "GCC Release ASAN",
      "toolchainFile": "/opt/vcpkg_asan/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "clang-debug",
      "inherits": ["base", "base-clang", "base-debug"],
      "displayName": "Clang Debug",
      "description": "Clang variant, DISABLED by default (set SOLUX_ENABLE_CLANG=1 to enable). FAISS + OpenMP are only set up in the gcc vcpkg repos, so configuring clang fails at find_package(OpenMP) / faiss here. Use the gcc presets.",
      "toolchainFile": "/opt/vcpkg_clang/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "clang-release",
      "inherits": ["base", "base-clang", "base-release"],
      "displayName": "Clang Release",
      "toolchainFile": "/opt/vcpkg_clang/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "clang-debug-asan",
      "inherits": ["base", "base-clang", "base-debug", "features-asan"],
      "displayName": "Clang Debug ASAN",
      "toolchainFile": "/opt/vcpkg_clang_asan/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "clang-release-asan",
      "inherits": ["base", "base-clang", "base-release", "features-asan"],
      "displayName": "Clang Release ASAN",
      "toolchainFile": "/opt/vcpkg_clang_asan/scripts/buildsystems/vcpkg.cmake"
    }
  ],

  "buildPresets": [
    { "name": "gcc-debug",        "configurePreset": "gcc-debug",        "description": "Recommended iteration build. Concurrent compiles are capped adaptively (physical cores + RAM, <=16) via the solux_compile Ninja pool in CMakeLists, so a plain -j is safe here and on smaller laptops." },
    { "name": "gcc-debug-asan",   "configurePreset": "gcc-debug-asan",   "description": "Memory-check build (pre-commit)." },
    { "name": "gcc-release",      "configurePreset": "gcc-release" },
    { "name": "gcc-release-asan", "configurePreset": "gcc-release-asan" }
  ]
}
