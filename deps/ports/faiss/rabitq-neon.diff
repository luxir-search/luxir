-// One accumulator per query bit plane. RaBitQuantizer caps qb at 8, so the
-// accumulator arrays below are fixed size rather than heap allocated.
 constexpr size_t kMaxQueryBits = 8;
 
-inline uint32x4_t accumulate_popcount(uint32x4_t acc, uint8x16_t value) {
