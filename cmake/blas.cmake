set(LUXIR_BLAS_VENDOR "OpenBLAS" CACHE STRING "LP64 BLAS/LAPACK provider: OpenBLAS, AOCL, ArmPL")
set_property(CACHE LUXIR_BLAS_VENDOR PROPERTY STRINGS OpenBLAS AOCL ArmPL)
set(LUXIR_BLAS_ROOT "" CACHE PATH "Optional BLAS provider installation (required for AOCL/ArmPL)")
if(NOT LUXIR_BLAS_VENDOR MATCHES "^(OpenBLAS|AOCL|ArmPL)$")
  message(FATAL_ERROR "Unknown LUXIR_BLAS_VENDOR=${LUXIR_BLAS_VENDOR}")
endif()
if(LUXIR_BLAS_VENDOR STREQUAL "AOCL" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
  message(FATAL_ERROR "AOCL requires an x86-64 target; use OpenBLAS or ArmPL on ARM64")
endif()
if(LUXIR_BLAS_VENDOR STREQUAL "ArmPL" AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
  message(FATAL_ERROR "ArmPL requires an ARM64 target")
endif()
if(NOT LUXIR_BLAS_VENDOR STREQUAL "OpenBLAS" AND NOT LUXIR_BLAS_ROOT)
  message(FATAL_ERROR "${LUXIR_BLAS_VENDOR} requires LUXIR_BLAS_ROOT with LP64 libraries")
endif()
if(NOT LUXIR_BLAS_VENDOR STREQUAL "OpenBLAS" AND
   (NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR LUXIR_STATIC_RUNTIME))
  message(FATAL_ERROR "Vendor BLAS requires Linux GCC shared runtimes (LUXIR_STATIC_RUNTIME=OFF); use the vendor GCC/libgomp distribution")
endif()

find_package(Threads REQUIRED)
add_library(luxir_blas INTERFACE)
target_link_libraries(luxir_blas INTERFACE Threads::Threads OpenMP::OpenMP_CXX)
target_compile_definitions(luxir_blas INTERFACE "LUXIR_BLAS_${LUXIR_BLAS_VENDOR}=1")

# FAISS's vcpkg export embeds OpenBLAS paths for both BLAS and LAPACK. Replace
# every such edge, retaining OpenMP and platform libraries. BLA_VENDOR alone
# cannot override an already imported FAISS target.
get_target_property(_luxir_faiss_links faiss INTERFACE_LINK_LIBRARIES)
set(_luxir_blas_links "")
foreach(_link IN LISTS _luxir_faiss_links)
  if(_link MATCHES "[Oo][Pp][Ee][Nn][Bb][Ll][Aa][Ss]")
    list(APPEND _luxir_blas_links "${_link}")
  endif()
endforeach()
if(NOT _luxir_blas_links)
  message(FATAL_ERROR "Expected the pinned FAISS export to link OpenBLAS; review its BLAS interface")
endif()
list(REMOVE_ITEM _luxir_faiss_links ${_luxir_blas_links})
if(LUXIR_BLAS_ROOT)
  # NO_DEFAULT_PATH avoids accidentally pairing vendor BLAS with system LAPACK.
  # Fixed LP64 names deliberately exclude *_ilp64 and *_64 variants.
  if(LUXIR_BLAS_VENDOR STREQUAL "OpenBLAS")
    find_library(_luxir_blas NAMES openblas PATHS "${LUXIR_BLAS_ROOT}/lib" "${LUXIR_BLAS_ROOT}/lib64" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(_luxir_blas_links "${_luxir_blas}")
  elseif(LUXIR_BLAS_VENDOR STREQUAL "AOCL")
    find_library(_luxir_blas NAMES libblis-mt.so PATHS "${LUXIR_BLAS_ROOT}/lib_LP64" "${LUXIR_BLAS_ROOT}/lib/LP64" "${LUXIR_BLAS_ROOT}/lib" "${LUXIR_BLAS_ROOT}/lib64" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    find_library(_luxir_lapack NAMES libflame.so PATHS "${LUXIR_BLAS_ROOT}/lib_LP64" "${LUXIR_BLAS_ROOT}/lib/LP64" "${LUXIR_BLAS_ROOT}/lib" "${LUXIR_BLAS_ROOT}/lib64" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(_luxir_blas_links "${_luxir_lapack};${_luxir_blas}")
    find_path(_luxir_blas_headers NAMES blis.h PATHS "${LUXIR_BLAS_ROOT}/include_LP64" "${LUXIR_BLAS_ROOT}/include" PATH_SUFFIXES "" blis NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(_luxir_blas_abi_source "#include <blis.h>\nstatic_assert(sizeof(f77_int) == 4);\nint main() {}")
  else()
    find_library(_luxir_blas NAMES libarmpl_lp64_mp.so PATHS "${LUXIR_BLAS_ROOT}/lib" "${LUXIR_BLAS_ROOT}/lib64" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(_luxir_blas_links "${_luxir_blas};OpenMP::OpenMP_CXX")
    find_path(_luxir_blas_headers NAMES armpl.h PATHS "${LUXIR_BLAS_ROOT}/include" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE REQUIRED)
    set(_luxir_blas_abi_source "#include <armpl.h>\nstatic_assert(sizeof(armpl_int_t) == 4);\nint main() {}")
  endif()
endif()
if(_luxir_blas_abi_source)
  include(CheckCXXSourceCompiles)
  include(CMakePushCheckState)
  cmake_push_check_state(RESET)
  set(CMAKE_REQUIRED_INCLUDES "${_luxir_blas_headers}")
  unset(_luxir_blas_lp64 CACHE)
  check_cxx_source_compiles("${_luxir_blas_abi_source}" _luxir_blas_lp64)
  cmake_pop_check_state()
  if(NOT _luxir_blas_lp64)
    message(FATAL_ERROR "${LUXIR_BLAS_VENDOR} headers must expose the LP64 integer ABI used by FAISS")
  endif()
endif()
list(REMOVE_DUPLICATES _luxir_blas_links)
target_link_libraries(luxir_blas INTERFACE ${_luxir_blas_links} m ${CMAKE_DL_LIBS})
set_property(TARGET faiss PROPERTY INTERFACE_LINK_LIBRARIES "${_luxir_faiss_links};luxir_blas")
message(STATUS "Luxir BLAS/LAPACK: ${LUXIR_BLAS_VENDOR} ${_luxir_blas_links}")
