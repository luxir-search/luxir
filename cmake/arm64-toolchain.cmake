# Linux x86-64 host, Linux AArch64 target. The cross compiler includes its sysroot.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

if("$ENV{LUXIR_ARM64_TOOLCHAIN}" STREQUAL "")
  message(FATAL_ERROR "Set LUXIR_ARM64_TOOLCHAIN to the AArch64 GCC toolchain directory")
endif()
set(_luxir_cross "$ENV{LUXIR_ARM64_TOOLCHAIN}/bin/aarch64-unknown-linux-gnu")
set(CMAKE_C_COMPILER "${_luxir_cross}-gcc")
set(CMAKE_CXX_COMPILER "${_luxir_cross}-g++")
set(CMAKE_AR "${_luxir_cross}-ar")
set(CMAKE_RANLIB "${_luxir_cross}-ranlib")
set(CMAKE_STRIP "${_luxir_cross}-strip")
if("$ENV{LUXIR_ARM64_SYSROOT}" STREQUAL "")
  message(FATAL_ERROR "Set LUXIR_ARM64_SYSROOT to the Linux ARM64 sysroot")
endif()
set(CMAKE_SYSROOT "$ENV{LUXIR_ARM64_SYSROOT}")
# Keep compiler runtimes in the executable, retaining the target's dynamic glibc.
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static-libstdc++ -static-libgcc")
# The triplet's flags apply to dependencies only; Luxir keeps the compiler's PIE default.
set(CMAKE_C_FLAGS_INIT "${VCPKG_C_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${VCPKG_CXX_FLAGS}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
