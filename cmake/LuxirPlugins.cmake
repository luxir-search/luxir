#
# Compiled-in plugin support. See docs/dev/plugins.md.
#
#   luxir_add_plugin(NAME <name> SOURCES <files...> [LIBRARIES <targets...>]
#                    [INCLUDE_DIRS <dirs...>] [TEST_SOURCES <files...>] [TEST_ONLY])
#
# Plugin directories (LUXIR_PLUGIN_DIRS plus test/plugins/example) call this from
# their CMakeLists.txt. luxir_finalize_plugins() then generates the registration
# translation units and the luxir_plugins / luxir_test_plugins libraries.

set_property(GLOBAL PROPERTY LUXIR_PLUGIN_NAMES "")
set_property(GLOBAL PROPERTY LUXIR_PLUGIN_RUNTIME_NAMES "")
set_property(GLOBAL PROPERTY LUXIR_PLUGIN_TEST_SOURCES "")

function(luxir_add_plugin)
  cmake_parse_arguments(P "TEST_ONLY" "NAME" "SOURCES;LIBRARIES;INCLUDE_DIRS;TEST_SOURCES" ${ARGN})
  if(NOT P_NAME MATCHES "^[a-z0-9_]+$")
    message(FATAL_ERROR "luxir_add_plugin: NAME '${P_NAME}' must match [a-z0-9_]+")
  endif()
  get_property(_names GLOBAL PROPERTY LUXIR_PLUGIN_NAMES)
  if(P_NAME IN_LIST _names)
    message(FATAL_ERROR "luxir_add_plugin: duplicate plugin '${P_NAME}'")
  endif()
  set(_target luxir_plugin_${P_NAME})
  add_library(${_target} STATIC ${P_SOURCES})
  target_link_libraries(${_target} PUBLIC luxir_lib ${P_LIBRARIES})
  # Plugins build against engine internals (search ops, readers), so they see
  # the include directories luxir_lib keeps private (generated protos, hash maps).
  target_include_directories(${_target} PRIVATE $<TARGET_PROPERTY:luxir_lib,INCLUDE_DIRECTORIES>)
  target_link_libraries(${_target} PRIVATE TBB::tbb)
  if(P_INCLUDE_DIRS)
    target_include_directories(${_target} PUBLIC ${P_INCLUDE_DIRS})
  endif()
  set_property(GLOBAL APPEND PROPERTY LUXIR_PLUGIN_NAMES ${P_NAME})
  if(NOT P_TEST_ONLY)
    set_property(GLOBAL APPEND PROPERTY LUXIR_PLUGIN_RUNTIME_NAMES ${P_NAME})
  endif()
  foreach(_f ${P_TEST_SOURCES})
    cmake_path(ABSOLUTE_PATH _f BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
    set_property(GLOBAL APPEND PROPERTY LUXIR_PLUGIN_TEST_SOURCES "${_f}")
  endforeach()
endfunction()

# Writes ${CMAKE_BINARY_DIR}/generated/<file> and defines static library <lib>
# holding addConfiguredPlugins() for the given plugin names.
function(_luxir_generate_plugin_lib lib file)
  set(_decls "")
  set(_adds "")
  set(_marks "")
  set(_libs "")
  foreach(_n ${ARGN})
    string(APPEND _decls "std::unique_ptr<::luxir::Plugin> luxir_plugin_create_${_n}();\n")
    string(APPEND _adds "  r.add(luxir_plugin_create_${_n}());\n")
    string(APPEND _marks "[[gnu::used, gnu::retain]] extern const char luxir_plugin_marker_${_n}[] = \"luxir-plugin-compiled:${_n}\";\n")
    list(APPEND _libs luxir_plugin_${_n})
  endforeach()
  set(_content "// Generated by cmake/LuxirPlugins.cmake. Do not edit.\n#include \"luxir/plugin/Plugin.h\"\n\n${_decls}\n// Greppable in the binary (strings/grep -a): proves which plugins are compiled in.\n${_marks}\nvoid luxir::addConfiguredPlugins(PluginRegistry& r) {\n  (void)r;\n${_adds}}\n")
  set(_path "${CMAKE_BINARY_DIR}/generated/${file}")
  set(_old "")
  if(EXISTS "${_path}")
    file(READ "${_path}" _old)
  endif()
  if(NOT _old STREQUAL _content)
    file(WRITE "${_path}" "${_content}")
  endif()
  add_library(${lib} STATIC "${_path}")
  target_link_libraries(${lib} PUBLIC luxir_lib ${_libs})
endfunction()

function(luxir_finalize_plugins)
  get_property(_all GLOBAL PROPERTY LUXIR_PLUGIN_NAMES)
  get_property(_runtime GLOBAL PROPERTY LUXIR_PLUGIN_RUNTIME_NAMES)
  get_property(_tests GLOBAL PROPERTY LUXIR_PLUGIN_TEST_SOURCES)
  _luxir_generate_plugin_lib(luxir_plugins luxir_plugins.cpp ${_runtime})
  _luxir_generate_plugin_lib(luxir_test_plugins luxir_test_plugins.cpp ${_all})
  target_link_libraries(luxir PRIVATE luxir_plugins)
  target_link_libraries(luxir_test PRIVATE luxir_test_plugins)
  if(_tests)
    target_sources(luxir_test PRIVATE ${_tests})
  endif()
  if(_runtime)
    string(REPLACE ";" ", " _shown "${_runtime}")
  else()
    set(_shown "none")
  endif()
  message(STATUS "Luxir plugins: ${_shown}")
endfunction()
