# One job of deps-image.yml: build and publish a Dockerfile stage of the
# development image for this machine's architecture, on the stages published
# before it. REGISTRY names the image repository; GH_TOKEN signs in.
#   deps-image toolchain | normal-dependencies | dev
set -euo pipefail
cd "$(dirname "$0")/.."
: "${REGISTRY:?image repository required}"
target=${1:?stage required}

case "$(uname -m)" in
  x86_64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) exit 2 ;;
esac
image="${REGISTRY,,}:$(python3 tools/benchmarks/deps-key.py .)-$arch"
case "$target" in
  toolchain) tag=$image-toolchain needs=() ;;
  normal-dependencies) tag=$image-normal needs=(TOOLCHAIN="$image-toolchain") ;;
  dev) tag=$image needs=(TOOLCHAIN="$image-toolchain" NORMAL_DEPENDENCIES="$image-normal") ;;
  *) echo "Usage: deps-image toolchain | normal-dependencies | dev" >&2; exit 2 ;;
esac

# Registry credentials live only in a per-invocation directory.
DOCKER_CONFIG=$(mktemp -d)
export DOCKER_CONFIG
trap 'rm -rf -- "$DOCKER_CONFIG"' EXIT
printf '%s' "${GH_TOKEN:?registry token required}" |
  docker login ghcr.io -u "${GITHUB_ACTOR:?}" --password-stdin

published() { timeout 60 docker manifest inspect "$1" >/dev/null 2>&1; }
summary=${GITHUB_STEP_SUMMARY:-/dev/stdout}
printf 'Source: %s\nDependency image: %s\n' "$(git rev-parse HEAD)" "$image" >> "$summary"
for done in "$image" "$tag"; do
  if published "$done"; then
    echo "Already published: $done" >> "$summary"
    exit 0
  fi
done
options=()
for need in "${needs[@]}"; do
  published "${need#*=}" || { echo "Missing ${need#*=}: an earlier stage failed" >&2; exit 1; }
  options+=(--build-arg "$need")
done
docker build --progress=plain -f .devcontainer/Dockerfile \
  --target "$target" --build-arg "BUILD_JOBS=$(nproc)" "${options[@]}" \
  --label "org.opencontainers.image.source=https://github.com/${GITHUB_REPOSITORY:?}" \
  -t "$tag" .
docker push "$tag"
